<Project>

  <!-- Build configuration -->
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks><!-- Required by CsWin32 -->
    <NoWarn>$(NoWarn);1591;NU1901;NU1902;NU1903;NU1904</NoWarn><!-- Missing XML comments + NuGet advisories -->
    <Version>1.0.0-pre</Version><!-- Dummy version number, overridden by GitVersion -->
  </PropertyGroup>

  <!-- Metadata -->
  <PropertyGroup>
    <Authors>Bastian Eicher</Authors>
    <Copyright>Copyright Bastian Eicher</Copyright>
    <RepositoryUrl>https://github.com/nano-byte/LightTag</RepositoryUrl>
  </PropertyGroup>

  <!-- Build-time dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="All" />
  </ItemGroup>

</Project>
