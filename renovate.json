{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":disableDependencyDashboard"],
  "packageRules": [
    {
      "matchPackagePatterns": ["^gittools"],
      "allowedVersions": "<4"
    },
    {
      "matchPackageNames": ["dotnet-sdk"],
      "matchUpdateTypes": ["patch"],
      "enabled": false,
      "description": "Using automatic roll-forward instead of explicit update"
    },
    {
      "matchPackagePatterns": ["^NanoByte\\.Common"],
      "groupName": "NanoByte.Common",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackagePatterns": ["CsWin32"],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
